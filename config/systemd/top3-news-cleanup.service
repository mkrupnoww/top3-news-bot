[Unit]
Description=TOP 3 NEWS Old Data Cleanup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=michael
Group=michael
WorkingDirectory=/opt/top3-news-bot

ExecStart=/opt/top3-news-bot/.venv/bin/python scripts/cleanup_old_data.py --execute

Environment=PYTHONUNBUFFERED=1

TimeoutStartSec=10min

NoNewPrivileges=true
PrivateTmp=true